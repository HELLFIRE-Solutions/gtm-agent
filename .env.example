# Claude API — resolved automatically if you've run `ant auth login`;
# otherwise set an explicit key here.
ANTHROPIC_API_KEY=

# HubSpot private-app token (Settings -> Integrations -> Private Apps).
# Needs scopes: crm.objects.contacts.read/write, crm.objects.notes.write
HUBSPOT_API_KEY=

# Sending mailbox (SMTP) — needs a verified domain (SPF/DKIM/DMARC).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Reply tracking mailbox (IMAP) — usually the same inbox as SMTP_FROM_ADDRESS.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# HubSpot Meetings scheduling link to attach once a lead is approved/replies.
HUBSPOT_MEETING_LINK=

# Website chat widget inbox (gtm_agent.inbox) -- connects as the scoped
# marketing_app role from internal-db/migrations/0007_scoped_app_roles.sql,
# never the superuser. Needed for `gtm-agent inbox list` and for running
# `python -m gtm_agent.inbox.server`.
GTM_AGENT_DATABASE_URL=postgresql://marketing_app:changeme@localhost:5433/hellfire_internal
INBOX_PORT=8090
INBOX_ALLOWED_ORIGINS=https://hellfiresol.com,https://www.hellfiresol.com
